class Child(Phone):

  def __init__(self, model, battery, camera, processor):
    super().__init__(model, battery, camera)
    self.processor=processor

  def charge(self,hour):
    print("fast charging")
    super().charge(hour) # Removed the explicit 'self' from the super() call

  pro=Child("motorola",5000,10,"sanp")
print(pro.model)
pro.charge(2)

class cooling_machanism:
  def __init__(self,cooling_method):
    self.cooling_method=cooling_method # Corrected typo: coliing_method -> cooling_method
  def coling_on(self):
    print(f"coling on {self.cooling_method}")


class mulitiple(Child,cooling_machanism):
  def __init__(self, model, battery, camera, processor,cooling_method):
    Child.__init__(self,model,battery,camera,processor)
    cooling_machanism.__init__(self,cooling_method)
